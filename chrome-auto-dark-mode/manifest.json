{
  "manifest_version": 3,
  "name": "Quick Color Inversion",
  "version": "1.1",
  "description": "Toggle color inversion globally or per-page with a single click.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toggle Color Inversion"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
